# CloutFox configuration (copy to .env to override defaults)

# Interface language: en or ru (default: the system language)
# CLOUTFOX_LANG=en

# Data folder: profiles, cookies, keys, settings, logs. Default
# ~/.local/share/cloutfox, on Windows %LOCALAPPDATA%\CloutFox.
# CLOUTFOX_HOME=

# Single paths inside it can be moved too, for example:
# CLOUTFOX_PROFILES_FILE=/path/profiles.json
# CLOUTFOX_DATA_DIR=/path/camoufox_data
# CLOUTFOX_LOG_DIR=/path/logs

# Log level (DEBUG, INFO, WARNING, ERROR)
CLOUTFOX_LOG_LEVEL=INFO

# Proxy check timeout in seconds
CLOUTFOX_PROXY_TIMEOUT=10

# Seconds the launch API waits for the browser to be ready
CLOUTFOX_LAUNCH_TIMEOUT=90

# Run browsers hidden (true) or with windows (false).
# CLOUTFOX_HEADLESS=false

# Reopen the tabs a profile had open when it was last stopped (default true).
# CLOUTFOX_RESTORE_TABS=true

# Optional token for the API and MCP (24+ characters). Without it any program on
# this computer can drive the browsers.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CLOUTFOX_API_TOKEN=

# Folders browser_upload may read files from, separated by ":" (";" on Windows),
# and the file types it may send. Hidden paths and key files are refused anywhere.
# CLOUTFOX_UPLOAD_DIRS=~/Pictures:~/Videos
# CLOUTFOX_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif,webp,heic,avif,mp4,mov,webm,m4v,mp3,m4a,wav,ogg

# Port of the local API; it always listens on 127.0.0.1
CLOUTFOX_API_PORT=8000
