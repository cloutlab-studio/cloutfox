#include <winver.h>
#include "version.h"

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cloutlab"
            VALUE "FileDescription", "CloutFox"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "CloutFox"
            VALUE "LegalCopyright", "MIT License, Cloutlab"
            VALUE "OriginalFilename", "CloutFox.exe"
            VALUE "ProductName", "CloutFox"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
