# Maintainer: Cloutlab <dev@cloutlab.studio>
# Generated by packaging/build.py linux from packaging/aur/PKGBUILD.in.
pkgname=cloutfox-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Anti-detect browser profile manager on Camoufox'
arch=('x86_64')
url='https://github.com/cloutlab-studio/cloutfox'
license=('MIT')
depends=(@DEPENDS@)
provides=('cloutfox')
conflicts=('cloutfox')
options=('!strip' '!debug')
source=("cloutfox-${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/cloutfox-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "cloutfox-${pkgver}"
    install -d "${pkgdir}/opt/cloutfox" "${pkgdir}/usr/bin"
    cp -a --no-preserve=ownership . "${pkgdir}/opt/cloutfox/"
    rm -r "${pkgdir}/opt/cloutfox/share"
    ln -s /opt/cloutfox/cloutfox "${pkgdir}/usr/bin/cloutfox"
    install -Dm644 share/cloutfox.desktop "${pkgdir}/usr/share/applications/cloutfox.desktop"
    install -Dm644 share/cloutfox.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cloutfox.png"
    install -Dm644 share/studio.cloutlab.cloutfox.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/studio.cloutlab.cloutfox.metainfo.xml"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
